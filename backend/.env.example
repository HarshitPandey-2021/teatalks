MONGO_URI=
MONGO_DB=TeaTalks
JWT_SECRET=

# One-time admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=
# If password contains # or spaces, wrap in quotes. Example: "teatalks#321"
ADMIN_CAMPUS_NAME=TeaTalks Admin
# Email address for moderation alerts (defaults to admin account email if unset)
ADMIN_NOTIFICATION_EMAIL=nextgendevcoders@gmail.com

# Public frontend URL (used in admin alert emails for login links)
FRONTEND_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=teatalks/posts

# Brevo SMTP (for signup and forgot-password OTP emails)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@teatalks.in
# Preferred on cloud hosts (HTTPS API, avoids SMTP port issues)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@teatalks.in
BREVO_SENDER_NAME=TeaTalks
# Optional: set true only for local debugging to print OTP in console if SMTP is missing
MAIL_ALLOW_CONSOLE_OTP=false
# Optional: set true only for local debugging to print admin alert details if mail is missing
MAIL_ALLOW_CONSOLE_ADMIN_ALERT=false
