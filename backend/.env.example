# Environment example for backend
PORT=5000
MONGO_DB=TeaTalks
# MONGO_URI should be set in your local .env (do NOT commit secrets)
# MONGO_URI="mongodb+srv://USER:PASS@cluster.mongodb.net/TeaTalks?retryWrites=true&w=majority"

# Moderation provider: purgomalum (default), gork
MODERATION_PROVIDER=purgomalum

# Gork/Gorq provider config (only required if MODERATION_PROVIDER=gork)
GORK_API_KEY=
GORK_API_URL=
GORK_TIMEOUT_MS=10000

# Other optional provider settings
PURGOMALUM_TIMEOUT_MS=15000
