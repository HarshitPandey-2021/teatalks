# TeaTalks — Render production environment (copy each KEY=VALUE into Render Dashboard)
# Rules: no quotes around values, no spaces around =, redeploy after saving.

# --- Required: core ---
NODE_ENV=production
MONGO_URI=your-mongodb-atlas-uri
JWT_SECRET=your-long-random-secret

# --- Required: email (Brevo API — primary on Render) ---
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@gmail.com
BREVO_SENDER_NAME=TeaTalks
SMTP_FROM=your-verified-sender@gmail.com
MAIL_PROVIDER_PRIORITY=api

# --- Required: admin moderation alerts ---
ADMIN_NOTIFICATION_EMAIL=your-admin-inbox@gmail.com
FRONTEND_URL=https://teatalks-six.vercel.app

# --- Required: image uploads ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
CLOUDINARY_UPLOAD_FOLDER=teatalks/posts

# --- Recommended: SMTP fallback if Brevo API fails ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-password

# --- Optional ---
CORS_ORIGINS=https://teatalks-six.vercel.app,http://localhost:3000
BREVO_API_TIMEOUT_MS=30000
MAIL_ALLOW_CONSOLE_OTP=false
MAIL_ALLOW_CONSOLE_ADMIN_ALERT=false

# --- One-time only (seed:admin script, not needed at runtime) ---
# ADMIN_EMAIL=teatalks@admin.com
# ADMIN_PASSWORD=your-admin-password
# ADMIN_CAMPUS_NAME=TeaTalks Admin
